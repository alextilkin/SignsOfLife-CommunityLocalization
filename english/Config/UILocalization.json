    "ID": "load.tip.toggleInventory",
    "Text": "Tip: You can toggle the inventory by pressing {0}."
  },
  {
    "ID": "load.tip.spaceUnprotected",
    "Text": "Useful Fact: The human body cannot survive unprotected in space."
  },
  {
    "ID": "load.tip.hudSlots",
    "Text": "Tip: You can scroll through the numbered slots on your HUD to switch to different equippable items from your inventory."
  },
  {
    "ID": "load.tip.itemsSpew",
    "Text": "Tip: Your items spew out of your body when you die, but they do not decay over time."
  },
  {
    "ID": "load.tip.itsFine",
    "Text": "Useful Fact: Its fine, everything is fine."
  },
  {
    "ID": "load.tip.megGems",
    "Text": "Tip: You can upgrade your MEG wrist laser with gems you find. This works because of a complex series of reasons."
  },
  {
    "ID": "load.tip.megLenses",
    "Text": "Tip: Better lenses will allow your MEG wrist laser to break through denser materials."
  },
  {
    "ID": "load.tip.grabLaser",
    "Text": "Tip: You can use the grab laser button ({0}) to move items to selected containers."
  },
  {
    "ID": "load.tip.hotbarMode",
    "Text": "Tip: You can switch from \"Automatic\" hotbar mode to \"Manual\" by pressing {0}."
  },
  {
    "ID": "load.tip.molecules",
    "Text": "Useful Fact: The human body contains both molecules and atoms."
  },
  {
    "ID": "load.tip.futuristic",
    "Text": "Scientists are saying the future is going to be far more futuristic than they originally predicted."
  },
  {
    "ID": "load.tip.helpButton",
    "Text": "Tip: If you get stuck, don't forget that you can check the help menu by pressing the ? button at the top of the screen."
  },
  {
    "ID": "load.tip.holster",
    "Text": "You can holster your current held item by pressing {0}."
  },
  {
    "ID": "load.tip.quickSlots",
    "Text": "Tip: Quick slots ({0} / {1}) hold gadgets and throwables you drag onto those HUD slots."
  },
  {
    "ID": "load.tip.map",
    "Text": "Tip: Press {0} to check your map and keep track of places you have discovered."
  },
  {
    "ID": "load.tip.reloadRadial",
    "Text": "Tip: Holding the reload button opens the ammo radial menu when your weapon has more than one ammo type."
  },
  {
    "ID": "load.tip.scanCodex",
    "Text": "Tip: Scanning a creature adds it to the MEG tool's codex so you can review it later."
  },
  {
    "ID": "load.tip.organize",
    "Text": "Tip: If you are carrying too much, use containers and the grab laser to organize items without opening every inventory."
  },
  {
    "ID": "load.tip.holdReload",
    "Text": "Tip: You can hold {0} to open the ammo radial menu."
  },
  {
    "ID": "load.tip.droppedNoDecay",
    "Text": "Tip: Items that you drop on the ground do not decay over time. You can trash them from your inventory."
  },
  {
    "ID": "load.tip.holdHotbar",
    "Text": "Tip: You can hold Hotbar buttons to open a radial item selection menu."
  },
  {
    "ID": "load.tip.futuristicTip",
    "Text": "Tip: Scientists are saying the future is going to be far more futuristic than they originally predicted."
  },
  {
    "ID": "load.tip.helpPauseMeg",
    "Text": "Tip: If you need help, you can access the help menu from the pause menu or the MEG tool."
  },
  {
    "ID": "load.tip.holsterTip",
    "Text": "Tip: You can holster your current held item by pressing {0}."
  },
  {
    "ID": "load.tip.scanCodexReview",
