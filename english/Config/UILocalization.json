  {
    "ID": "mods.stagedBlurb",
    "Text": "These packages are ready to publish. Pick one and the game will check the mods published by your Steam account.\n\nA new package creates a private or public Workshop page according to workshop.json. A package already linked to one of your Workshop items updates that item in place."
  },
  {
    "ID": "mods.publishedBlurbUpdate",
    "Text": "You already picked a staged package. Now choose which live Workshop mod it should replace.\n\nOnly click Update This One on the mod you mean to change. That swaps the files for everyone who subscribed — so double-check the title."
  },
  {
    "ID": "mods.publishedBlurb",
    "Text": "These are mods YOU already put on the Steam Workshop. Other players can find and subscribe to them.\n\nView Online opens the Steam page. Delete removes it forever for everyone — not just from your PC.\n\nWant to change a mod's files? Go to Staged Mods and publish its staged package; the game will identify the existing item."
  },
  {
    "ID": "mods.emptyInstalled",
    "Text": "No mods loaded this session.\n\nUse Find Mods to subscribe in Steam. New packs load automatically when ready; Pending packs can use Load Now."
  },
  {
    "ID": "mods.refreshing",
    "Text": "Refreshing Steam Workshop subscriptions…"
  },
  {
    "ID": "mods.emptyPublishedUpdate",
    "Text": "You do not have any published Workshop mods yet.\n\nGo back to Staged Mods and publish the package first."
  },
  {
    "ID": "mods.emptyPublished",
    "Text": "No published Steam Workshop mods found for your account yet.\n\nWhen you are ready to put a mod online, open Staged Mods and publish its package."
  },
  {
    "ID": "mods.emptyEditCandidates",
    "Text": "No valid mod candidates were found in your WorkshopUpload directory. \nThe path to the directory is:\n\n{0}\n\nFor more information, visit the official Signs of Life wiki by clicking the button below."
  },
  {
    "ID": "mods.selectReplaceData",
    "Text": "Select the Mod Data that you would like to upload to replace the data for the Steam Workshop item: {0}."
  },
  {
    "ID": "mods.emptyStaged",
    "Text": "Nothing is staged yet — so there is nothing to upload.\n\nUse Mod Prep (or put a finished package in your WorkshopUpload folder) first. Staged means \"ready to send to Steam,\" not \"already online.\"\n\nFolder:\n{0}\n\nNeed help? Open Publishing Guide below."
  },
  {
    "ID": "mods.checkingAccount",
    "Text": "Checking the mods published by your Steam account…\n\nNothing will be uploaded until the game determines whether this package should create a new Workshop item or update an existing one."
